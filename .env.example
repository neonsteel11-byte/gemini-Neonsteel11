# Copy this file to .env and fill in your real keys.
# NEVER commit the real .env file to GitHub.

# Required: Get free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional upgrades (leave blank to use free defaults):
ELEVENLABS_API_KEY=
GEMINI_IMAGE_MODE=false

# Required only if using --upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
